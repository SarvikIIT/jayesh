# Copy to .env and edit. Every value mirrors an arena.py env var;
# defaults below match arena.py (except TZ/WORKERS, tuned for the event).
# The container's local time decides DEADLINE: set TZ=Asia/Kolkata for IST.

# e.g. 2026-10-08T18:00 in the TZ above. Empty = uploads never auto-close.
DEADLINE=
# Deals each way per live fight / per final fight.
DEALS=200
FINAL_DEALS=500
# Seconds between uploads per team.
COOLDOWN=600
# Fights run at once. Rule of thumb: CPU cores minus one (Oracle free VM: 3).
WORKERS=3
# Container timezone. Needs no extra setup; the image ships tzdata.
TZ=Asia/Kolkata
# Host port nginx listens on.
NGINX_HTTP_PORT=80
# Per-fight container caps. Each fight runs in its own container; peak memory
# is WORKERS x MATCH_MEMORY, so keep that under the VM's RAM.
MATCH_MEMORY=2g
# Capped at the host's core count automatically.
MATCH_CPUS=4
# Organiser panel at /admin. Leave empty: scripts/deploy.sh fills in a random key.
ADMIN_KEY=
